<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BikeGesture Hands-Free Controller"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/telemetryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jaw: 0.00 | Pucker: 0.00 | Tongue: 0.00"
        android:textColor="#00E676"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:paddingTop="12dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready — Open mouth (Vol+), Pinch (Vol-), Tongue (Zoom/Nav)"
        android:textColor="#FFD54F"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingTop="8dp"
        android:paddingBottom="12dp" />

    <LinearLayout
        android:id="@+id/simControlsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnSimJaw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Jaw Open" />

        <Button
            android:id="@+id/btnSimPucker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Lip Pinch" />

        <Button
            android:id="@+id/btnSimTongue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Tongue Out" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Global Zoom/Nav (Accessibility)" />

</LinearLayout>
